# 服務埠（music-release-agent 預設指向 3013）
PORT=3013

# === 翻譯 provider ===
# gemini（預設，需 GEMINI_API_KEY）或 ollama（本地模型，零 API 費用）
LYRICS_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Ollama 設定（LYRICS_PROVIDER=ollama 時生效）
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# 主模型失敗時自動嘗試的 fallback 模型（選用）
# OLLAMA_FALLBACK_MODEL=qwen2.5:14b

# === Obsidian vault ===
# 翻譯落盤目錄（Obsidian 相容 Markdown）。支援 ~ 展開。
# 預設 data/lyrics-vault/；指到你的 Obsidian vault 即可把翻譯收進筆記庫：
# LYRICS_VAULT_DIR=~/Obsidian/MusicNotes/lyrics
# （LYRICS_CACHE_DIR 為 music-release-agent 時代的舊名，仍相容）

# === Spotify Web 歌詞轉接器（實驗性、本機專用、選用）===
# 僅在你自行執行 npm run auth:spotify 後啟用；詳見 README 的合規說明
# SPOTIFY_SP_DC=
# SPOTIFY_ACCESS_TOKEN=
